<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#20FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1F2023"
                android:centerColor="#3A3C40"
                android:endColor="#171719"
                android:type="linear" />
            <corners android:radius="@dimen/button_radius_primary" />
            <stroke
                android:width="1dp"
                android:color="@color/color_silver" />
        </shape>
    </item>
</ripple>
