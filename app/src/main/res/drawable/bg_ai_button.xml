<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#30FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#0A0A0B"
                android:centerColor="#292A2D"
                android:endColor="#171719"
                android:type="linear" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1.5dp"
                android:color="#BFC1C4" />
        </shape>
    </item>
</ripple>
