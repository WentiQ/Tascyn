<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/color_card_bg"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/color_card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgSessionStatusIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_timer_precision"
                app:tint="@color/color_icon_secondary" />

            <TextView
                android:id="@+id/txtSessionTitle"
                style="@style/TextAppearance.Tascyn.TaskTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textSize="14sp"
                tools:text="Robotics Simulation Initial Setup" />

            <TextView
                android:id="@+id/txtSessionDurationFormula"
                style="@style/TextAppearance.Tascyn.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_quadrant_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:textStyle="bold"
                tools:text="1h 15m 0s" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtSessionLinkedTask"
                style="@style/TextAppearance.Tascyn.Metadata"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/color_text_secondary"
                tools:text="Linked: Robotics Kinematics Control" />

            <TextView
                android:id="@+id/txtSessionTimeRange"
                style="@style/TextAppearance.Tascyn.Metadata"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_text_secondary"
                tools:text="10:00 AM - 11:15 AM" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
