<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollSettingsSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:outlineProvider="background"
    android:clipToOutline="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_chip_pearl" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_settings_precision"
                app:tint="@color/color_icon_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Settings"
                    android:textColor="@color/color_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Gemini AI, Theme &amp; Preferences"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnCloseSettingsSheet"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_pearl"
                android:padding="6dp"
                android:src="@drawable/ic_close_precision"
                app:tint="@color/color_icon_primary" />
        </LinearLayout>

        <!-- SECTION 1: APPEARANCE & THEME -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-bold"
            android:text="APPEARANCE &amp; THEME"
            android:textColor="@color/color_text_tertiary"
            android:textSize="11.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Color Theme"
                android:textColor="@color/color_text_primary"
                android:textSize="13.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif"
                android:text="Choose Light, Dark or follow your Android system mode."
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp" />

            <!-- Theme Switcher Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- Light Option -->
                <LinearLayout
                    android:id="@+id/btnThemeLight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_theme_option_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="4dp">

                    <ImageView
                        android:id="@+id/iconThemeLight"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_theme_light"
                        app:tint="@color/color_text_primary" />

                    <TextView
                        android:id="@+id/lblThemeLight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Light"
                        android:textColor="@color/color_text_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Dark Option -->
                <LinearLayout
                    android:id="@+id/btnThemeDark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_theme_option_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="4dp">

                    <ImageView
                        android:id="@+id/iconThemeDark"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_theme_dark"
                        app:tint="@color/color_text_primary" />

                    <TextView
                        android:id="@+id/lblThemeDark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Dark"
                        android:textColor="@color/color_text_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- System Option -->
                <LinearLayout
                    android:id="@+id/btnThemeSystem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_theme_option_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="4dp">

                    <ImageView
                        android:id="@+id/iconThemeSystem"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_theme_system"
                        app:tint="@color/color_accent" />

                    <TextView
                        android:id="@+id/lblThemeSystem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="System"
                        android:textColor="@color/color_accent"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- SECTION 2: GEMINI AI API CONFIGURATION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-bold"
            android:text="GEMINI AI CONFIGURATION"
            android:textColor="@color/color_text_tertiary"
            android:textSize="11.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_sparkle_ai"
                    app:tint="#6366F1" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="Google Gemini API Key"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/txtGeminiStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_connected"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Active"
                    android:textColor="@color/color_badge_connected_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif"
                android:text="Required for AI task parser, schema generation &amp; smart scheduling."
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp" />

            <!-- API Key Input Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <EditText
                    android:id="@+id/edtGeminiApiKey"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:hint="Paste API Key (AIzaSy...)"
                    android:inputType="textPassword"
                    android:textColor="@color/color_text_primary"
                    android:textColorHint="@color/color_text_tertiary"
                    android:textSize="12.5sp" />

                <ImageView
                    android:id="@+id/btnToggleApiKeyVisibility"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_stats_bars"
                    app:tint="@color/color_icon_secondary" />
            </LinearLayout>

            <!-- AI Model Selector Header & Doc Link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="Gemini Model"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnGeminiModelsLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="6dp"
                    android:text="Available Models ↗"
                    android:textColor="@color/color_accent"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif"
                android:text="Select a model or enter a custom model identifier."
                android:textColor="@color/color_text_secondary"
                android:textSize="11.5sp" />

            <!-- Model Dropdown Spinner (Full Width) -->
            <Spinner
                android:id="@+id/spinnerAiModel"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field" />

            <!-- Custom Model Input Field (Shown when Custom Model option is selected) -->
            <LinearLayout
                android:id="@+id/layoutCustomModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Custom Model ID"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="11.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <EditText
                        android:id="@+id/edtCustomAiModel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:fontFamily="monospace"
                        android:hint="e.g. gemini-2.5-flash or gemini-3.0-pro"
                        android:inputType="textNoSuggestions|textVisiblePassword"
                        android:singleLine="true"
                        android:textColor="@color/color_text_primary"
                        android:textColorHint="@color/color_text_tertiary"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Test Connection & Save Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTestGeminiKey"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="Test Key"
                    android:textAllCaps="false"
                    android:textColor="@color/color_text_primary"
                    android:textSize="12.5sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/color_card_border" />

                <Button
                    android:id="@+id/btnSaveGeminiKey"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/color_btn_primary_bg"
                    android:fontFamily="sans-serif-bold"
                    android:text="Save Key"
                    android:textAllCaps="false"
                    android:textColor="@color/color_btn_primary_text"
                    android:textSize="12.5sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- SECTION 4: BACKGROUND ACTIVITY & ALARM PERMISSIONS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif-bold"
            android:text="BACKGROUND ACTIVITY &amp; ALARMS"
            android:textColor="@color/color_text_tertiary"
            android:textSize="11.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif"
            android:text="Ensure alerts &amp; alarms fire on time even when phone is locked or asleep."
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- 1. Notification Permission -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Notification Alerts"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Push notifications for attention-needed tasks"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtNotifPermBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_connected"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Granted"
                    android:textColor="@color/color_badge_connected_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGrantNotifPerm"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:paddingVertical="0dp"
                android:text="Configure Notification Permission"
                android:textAllCaps="false"
                android:textColor="@color/color_text_primary"
                android:textSize="12sp"
                app:cornerRadius="6dp"
                app:strokeColor="@color/color_card_border" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/color_divider" />

            <!-- 2. Exact Alarms Permission -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Exact Alarm &amp; Full-Screen Alerts"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Full-screen alarm clock alerts for urgent/overdue"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtExactAlarmBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_connected"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Granted"
                    android:textColor="@color/color_badge_connected_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGrantExactAlarm"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:paddingVertical="0dp"
                android:text="Allow Exact Alarms Setting"
                android:textAllCaps="false"
                android:textColor="@color/color_text_primary"
                android:textSize="12sp"
                app:cornerRadius="6dp"
                app:strokeColor="@color/color_card_border" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/color_divider" />

            <!-- 3. Battery Optimization (Doze Whitelist) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Battery Optimization Exemption"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Prevents OS from sleeping/killing alarms"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtBatteryOptBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_connected"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Unrestricted"
                    android:textColor="@color/color_badge_connected_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnFixBatteryOptimization"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:paddingVertical="0dp"
                android:text="Disable Battery Optimization"
                android:textAllCaps="false"
                android:textColor="@color/color_text_primary"
                android:textSize="12sp"
                app:cornerRadius="6dp"
                app:strokeColor="@color/color_card_border" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/color_divider" />

            <!-- 4. System App Settings / Full Screen Over Other Apps -->
            <Button
                android:id="@+id/btnOpenAppSettings"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:backgroundTint="@color/color_btn_primary_bg"
                android:fontFamily="sans-serif-bold"
                android:text="Open System App Info &amp; Permissions"
                android:textAllCaps="false"
                android:textColor="@color/color_btn_primary_text"
                android:textSize="12.5sp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- SECTION 5: APP PREFERENCES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-bold"
            android:text="APP PREFERENCES"
            android:textColor="@color/color_text_tertiary"
            android:textSize="11.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Urgent &amp; Overdue Notifications"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/color_divider" />

            <LinearLayout
                android:id="@+id/btnExportData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Export Tasks &amp; Sessions (JSON)"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/color_icon_secondary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/color_divider" />

            <LinearLayout
                android:id="@+id/btnImportData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Import Tasks &amp; Sessions (JSON File)"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/color_icon_secondary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/color_divider" />

            <LinearLayout
                android:id="@+id/btnScanQrData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Scan QR to Import Tasks from Phone"
                    android:textColor="@color/color_accent"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/color_accent" />
            </LinearLayout>
        </LinearLayout>

        <!-- SECTION 5: PHONE-TO-PHONE TASK TRANSFER QR -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-bold"
            android:text="DEVICE SYNC &amp; TASK TRANSFER QR"
            android:textColor="@color/color_text_tertiary"
            android:textSize="11.5sp" />

        <LinearLayout
            android:id="@+id/cardQrTransfer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_stats_bars"
                    app:tint="@color/color_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="My Task Sync QR"
                        android:textColor="@color/color_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtQrTaskSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Scan with another phone to transfer tasks"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnCardScanQr"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Scan QR"
                    android:textAllCaps="false"
                    android:textColor="@color/color_accent"
                    android:textSize="11.5sp"
                    app:cornerRadius="6dp"
                    app:strokeColor="@color/color_accent" />
            </LinearLayout>

            <!-- PhonePe-style QR Preview Container -->
            <LinearLayout
                android:id="@+id/layoutQrContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/imgSyncQrCode"
                            android:layout_width="190dp"
                            android:layout_height="190dp"
                            android:scaleType="fitCenter" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Scan this code from Tascyn on another phone to import"
                    android:textColor="@color/color_text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Version Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:text="Tascyn v1.0"
            android:textColor="@color/color_text_tertiary"
            android:textSize="11.5sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>