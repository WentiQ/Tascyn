<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Tascyn.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Interlocking Check Action -->
        <FrameLayout
            android:id="@+id/btnTaskCheck"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgCheckCircle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_precision_circle"
                app:tint="@color/color_steel" />

            <com.example.tascyn.ui.components.InterlockingGeometryView
                android:id="@+id/viewInterlockingCheck"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Main Content Area -->
        <LinearLayout
            android:id="@+id/layoutTaskInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@id/btnTaskMore"
            app:layout_constraintStart_toEndOf="@id/btnTaskCheck"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Title -->
            <TextView
                android:id="@+id/txtTaskTitle"
                style="@style/TextAppearance.Tascyn.TaskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/color_void"
                android:textSize="15sp"
                tools:text="Robotics Kinematics Control Simulation" />

            <!-- Comment preview if any -->
            <TextView
                android:id="@+id/txtTaskComment"
                style="@style/TextAppearance.Tascyn.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Need to verify inverse kinematics matrix before submission."
                tools:visibility="visible" />

            <!-- Formula Badges Row 1: Quadrant & Urgency / Time Left -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Quadrant Badge (e.g. Q16 - Do Now) -->
                <TextView
                    android:id="@+id/txtQuadrantBadge"
                    style="@style/TextAppearance.Tascyn.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_quadrant_badge"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/color_void"
                    android:textStyle="bold"
                    tools:text="Q16 · Do Now" />

                <!-- Time Left / Urgency Badge -->
                <TextView
                    android:id="@+id/txtTimeLeftBadge"
                    style="@style/TextAppearance.Tascyn.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_urgency_red"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/color_urgent_red"
                    android:textStyle="bold"
                    tools:text="Urgent · 0d 2h 0m" />

                <!-- Priority Badge -->
                <TextView
                    android:id="@+id/txtPriorityBadge"
                    style="@style/TextAppearance.Tascyn.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_pearl"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/color_steel"
                    tools:text="HIGH" />
            </LinearLayout>

            <!-- Metadata Row 2: Total Duration, Subtasks Count, Task Types -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Total Duration (Formula 2.1) -->
                <TextView
                    android:id="@+id/txtTotalDuration"
                    style="@style/TextAppearance.Tascyn.Metadata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_time_precision"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/color_steel"
                    android:textColor="@color/color_steel"
                    android:textSize="11sp"
                    tools:text="2h 25m total" />

                <!-- Sub-tasks count badge -->
                <TextView
                    android:id="@+id/txtSubtasksCount"
                    style="@style/TextAppearance.Tascyn.Metadata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:drawableStart="@drawable/ic_subtask_precision"
                    android:drawablePadding="3dp"
                    android:drawableTint="@color/color_steel"
                    android:textColor="@color/color_steel"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="2 sub-tasks"
                    tools:visibility="visible" />

                <!-- Task Type Chips Container -->
                <TextView
                    android:id="@+id/txtTaskTypes"
                    style="@style/TextAppearance.Tascyn.Metadata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/color_graphite"
                    android:textSize="11sp"
                    tools:text="Academic · Lab" />
            </LinearLayout>

        </LinearLayout>

        <!-- More actions / Quick start session -->
        <LinearLayout
            android:id="@+id/btnTaskMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnQuickStartSession"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_pearl"
                android:padding="6dp"
                android:src="@drawable/ic_play_precision"
                app:tint="@color/color_void" />

            <ImageView
                android:id="@+id/btnTaskOptions"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="6dp"
                android:padding="4dp"
                android:src="@drawable/ic_more_precision"
                app:tint="@color/color_steel" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
