<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Scrollable Content Area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/layoutAlarmActionsBottom"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- App Logo Header -->
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:text="TASCYN ALARM"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />

            <!-- Urgency Status Pill -->
            <LinearLayout
                android:id="@+id/layoutAlarmBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_badge_disconnected"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp">

                <View
                    android:id="@+id/dotAlarmIndicator"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_notification_badge"
                    android:backgroundTint="#EF4444" />

                <TextView
                    android:id="@+id/txtAlarmBadgeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.06"
                    android:text="TASK OVERDUE"
                    android:textColor="#DC2626"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Subtitle Description -->
            <TextView
                android:id="@+id/txtAlarmTimeSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Due date has passed. Immediate action required."
                android:textColor="#6B7280"
                android:textSize="13.5sp" />

            <!-- Large Task Title -->
            <TextView
                android:id="@+id/txtAlarmTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:textColor="#0E0E10"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="Wash My Clothes" />

            <!-- Card with Task Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Quadrant & Priority Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtAlarmQuadrant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_pearl"
                        android:fontFamily="sans-serif-bold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:textColor="#1F2937"
                        android:textSize="12.5sp"
                        tools:text="Q26 · Start &amp; Push" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/txtAlarmPriority"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#6B7280"
                        android:textSize="12.5sp"
                        tools:text="Priority: Medium" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#E5E7EB" />

                <!-- Due Date Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_time_precision"
                        app:tint="#4B5563" />

                    <TextView
                        android:id="@+id/txtAlarmDueTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#1F2937"
                        android:textSize="13.5sp"
                        tools:text="Due: Saturday, Sept 12 · 6:00 pm" />
                </LinearLayout>

                <!-- Minimum Time Required Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_timer_precision"
                        app:tint="#4B5563" />

                    <TextView
                        android:id="@+id/txtAlarmMinTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:textColor="#4B5563"
                        android:textSize="13sp"
                        tools:text="Minimum Required Time: 0d 0h 40m" />
                </LinearLayout>

                <!-- Note/Comment Row if available -->
                <TextView
                    android:id="@+id/txtAlarmComment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-italic"
                    android:textColor="#6B7280"
                    android:textSize="12.5sp"
                    android:visibility="gone"
                    tools:text="Note: Needs to be done by 6:00 PM today."
                    tools:visibility="visible" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Controls -->
    <LinearLayout
        android:id="@+id/layoutAlarmActionsBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Button 1: Snooze 10 Minutes (Solid Carbon Pill) -->
        <Button
            android:id="@+id/btnAlarmSnooze10m"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#0E0E10"
            android:fontFamily="sans-serif-bold"
            android:text="Snooze 10 Minutes"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:cornerRadius="12dp" />

        <!-- Button 2: Reschedule / Custom Reminder (Outlined White Pill) -->
        <Button
            android:id="@+id/btnAlarmReschedule"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-bold"
            android:text="Reschedule / Custom Reminder"
            android:textAllCaps="false"
            android:textColor="#0E0E10"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:strokeColor="#D1D5DB"
            app:strokeWidth="1.5dp" />

        <!-- Bottom Action Row: Mark Done & Dismiss -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAlarmMarkDone"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#10B981"
                android:fontFamily="sans-serif-bold"
                android:text="Mark Complete"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnAlarmDismiss"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Dismiss"
                android:textAllCaps="false"
                android:textColor="#6B7280"
                android:textSize="13.5sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
