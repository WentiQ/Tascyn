<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Bottom Sheet Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_chip_pearl" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_timer_precision"
                app:tint="@color/color_void" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Tascyn.SectionHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Timesheets &amp; Live Tracking" />

                <TextView
                    android:id="@+id/txtTimesheetsSummary"
                    style="@style/TextAppearance.Tascyn.Metadata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Formula 4.1 Duration Calculation Engine"
                    android:textColor="@color/color_steel" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnCloseTimesheetsSheet"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_pearl"
                android:padding="6dp"
                android:src="@drawable/ic_close_precision"
                app:tint="@color/color_carbon" />
        </LinearLayout>

        <!-- Active Live Session Card (if session running) -->
        <LinearLayout
            android:id="@+id/cardActiveSessionInSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_live_ticker"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Tascyn.Micro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CURRENT ACTIVE SESSION"
                    android:textColor="@color/color_void"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtActiveSessionElapsedLive"
                    style="@style/TextAppearance.Tascyn.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_void"
                    android:textSize="22sp"
                    tools:text="00:25:14" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtActiveSessionTaskName"
                style="@style/TextAppearance.Tascyn.TaskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Robotics Kinematics Control Simulation"
                android:textColor="@color/color_void" />

            <TextView
                android:id="@+id/txtActiveSessionCountdown"
                style="@style/TextAppearance.Tascyn.Metadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Remaining against 3h min time: 02:34:46"
                android:textColor="@color/color_steel" />

            <Button
                android:id="@+id/btnEndActiveSessionSheet"
                style="@style/Widget.Tascyn.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Stop &amp; Log Session" />
        </LinearLayout>

        <!-- Quick Start New Session Form -->
        <LinearLayout
            android:id="@+id/layoutStartNewSessionForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_precision"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/TextAppearance.Tascyn.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="START NEW SESSION"
                android:textColor="@color/color_steel" />

            <EditText
                android:id="@+id/edtNewSessionTitle"
                style="@style/TextAppearance.Tascyn.Secondary"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:hint="Session Title (e.g. Kinematics Derivation)"
                android:paddingHorizontal="10dp"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerLinkTask"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field" />

            <Button
                android:id="@+id/btnStartNewSession"
                style="@style/Widget.Tascyn.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Start Tracking Now" />
        </LinearLayout>

        <!-- Past Sessions Log -->
        <TextView
            style="@style/TextAppearance.Tascyn.Micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="SESSION HISTORY (LOGGED SESSIONS)"
            android:textColor="@color/color_steel" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerTimesheetsLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
