<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutAnalyticsPageView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_canvas"
    android:clipToPadding="false"
    android:paddingBottom="36dp"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Page Header & Period Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="Analytics"
                android:textColor="@color/color_text_primary"
                android:textSize="29sp"
                android:textStyle="bold" />

            <!-- Period Switcher Pills -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_summary_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/btnPeriod7Days"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_chip_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="7D"
                    android:textColor="@color/color_btn_primary_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnPeriod30Days"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="30D"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnPeriodAllTime"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="ALL"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Subtitle Date Range -->
        <TextView
            android:id="@+id/txtAnalyticsDateRangeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:paddingHorizontal="20dp"
            android:text="Past 7 Days productivity overview"
            android:textColor="@color/color_text_tertiary"
            android:textSize="13sp" />

        <!-- ============================================================= -->
        <!-- 4 KPI SUMMARY METRIC CARDS (2x2 Grid)                         -->
        <!-- ============================================================= -->
        <!-- KPI Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <!-- Card 1: Total Focus -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_analytics_kpi"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.06"
                    android:text="TOTAL FOCUS"
                    android:textColor="@color/color_text_tertiary"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAnalyticsTotalFocus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-black"
                    android:text="0h 0m"
                    android:textColor="@color/color_text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAnalyticsFocusAvg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="0m / day avg"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Card 2: Completed Sessions -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_analytics_kpi"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.06"
                    android:text="SESSIONS"
                    android:textColor="@color/color_text_tertiary"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAnalyticsSessionsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-black"
                    android:text="0"
                    android:textColor="@color/color_text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAnalyticsSessionAvg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="0m avg duration"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- KPI Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- Card 3: Completion Rate -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_analytics_kpi"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.06"
                    android:text="COMPLETION RATE"
                    android:textColor="@color/color_text_tertiary"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAnalyticsCompletionRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-black"
                    android:text="0%"
                    android:textColor="@color/color_text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAnalyticsDoneVsTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="0 of 0 tasks"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Card 4: Focus Streak -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_analytics_kpi"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.06"
                    android:text="FOCUS STREAK"
                    android:textColor="@color/color_text_tertiary"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAnalyticsCurrentStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-black"
                    android:text="0 days"
                    android:textColor="@color/color_text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAnalyticsBestStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="Active focus streak"
                    android:textColor="@color/color_accent"
                    android:textSize="11.5sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- ============================================================= -->
        <!-- SECTION 1: DAILY FOCUS DURATION BAR CHART                     -->
        <!-- ============================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_summary_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="Daily Focus Duration"
                    android:textColor="@color/color_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txtDailyTargetLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Target: 2h/day"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Tap any bar to inspect daily focus details"
                android:textColor="@color/color_text_tertiary"
                android:textSize="12sp" />

            <com.example.tascyn.ui.components.FocusBarChartView
                android:id="@+id/chartDailyFocus"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <!-- ============================================================= -->
        <!-- SECTION 2: CATEGORY FOCUS DISTRIBUTION DONUT CHART            -->
        <!-- ============================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_summary_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Category Breakdown"
                android:textColor="@color/color_text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Focus time allocated across task domains"
                android:textColor="@color/color_text_tertiary"
                android:textSize="12sp" />

            <com.example.tascyn.ui.components.CategoryDonutChartView
                android:id="@+id/chartCategoryDistribution"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp" />

            <!-- Category Legend Pills -->
            <LinearLayout
                android:id="@+id/containerCategoryLegends"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- ============================================================= -->
        <!-- SECTION 3: 24-HOUR PRODUCTIVITY BY TIME OF DAY (CONTINUOUS)   -->
        <!-- ============================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_summary_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Productivity by Time of Day"
                        android:textColor="@color/color_text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:text="24-hour focus rhythm for selected period"
                        android:textColor="@color/color_text_tertiary"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Prime Focus Zone Pill Badge -->
                <TextView
                    android:id="@+id/txtAnalyticsPeakZoneBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_urgency_orange"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.02"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="🔥 Peak: 09:00 - 13:00"
                    android:textColor="@color/color_attention_orange"
                    android:textSize="11.5sp" />

            </LinearLayout>

            <!-- Continuous Spline Productivity Graph -->
            <com.example.tascyn.ui.components.FocusHourlyDistributionView
                android:id="@+id/chartHourlyDistribution"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="12dp" />

            <!-- Bottom Productivity Summary Insights -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chip_tag"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <!-- Best Hour -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Peak Hour"
                        android:textColor="@color/color_text_tertiary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/txtAnalyticsPeakHourVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="10:00 AM"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="@color/color_divider" />

                <!-- Prime Window -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1.2"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Prime Focus Window"
                        android:textColor="@color/color_text_tertiary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/txtAnalyticsPrimeRangeVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="09:00 - 13:00"
                        android:textColor="@color/color_accent"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="@color/color_divider" />

                <!-- Window Share -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Window Focus"
                        android:textColor="@color/color_text_tertiary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/txtAnalyticsPrimeShareVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="68% of work"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ============================================================= -->
        <!-- SECTION 4: COMPLETION DISCIPLINE & BEHAVIOR                   -->
        <!-- Reveals user procrastination, discipline & execution behavior -->
        <!-- ============================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_summary_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Completion Behavior &amp; Discipline"
                        android:textColor="@color/color_text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:text="Reveals execution timing, procrastination &amp; deadline discipline"
                        android:textColor="@color/color_text_tertiary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Discipline Badge Pill -->
                <TextView
                    android:id="@+id/txtAnalyticsDisciplineBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_tag"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="ON TRACK"
                    android:textColor="@color/color_on_track_green"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Overall Discipline Summary Metric Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_analytics_kpi"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.06"
                        android:text="ON-TIME DISCIPLINE SCORE"
                        android:textColor="@color/color_text_tertiary"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtAnalyticsDisciplineDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:text="Tasks finished before or on deadline"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtAnalyticsDisciplineScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="0%"
                    android:textColor="@color/color_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Zone 1: Completed After Overdue (Procrastination) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_urgency_red" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Completed After Overdue"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Procrastinated past due date"
                        android:textColor="@color/color_text_tertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtCompletedOverdueStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="0 (0%)"
                    android:textColor="@color/color_urgent_red"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Zone 2: Completed in Urgent Zone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_urgency_red_light" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Completed in Urgent Zone"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Rushed last-minute (&lt; minimum time)"
                        android:textColor="@color/color_text_tertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtCompletedUrgentStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="0 (0%)"
                    android:textColor="@color/color_attention_orange"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Zone 3: Completed in Attention Needed Zone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_urgency_orange" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Completed in Attention Zone"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Active deadline window (1x - 2x min time)"
                        android:textColor="@color/color_text_tertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtCompletedAttentionStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="0 (0%)"
                    android:textColor="@color/color_attention_orange"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Zone 4: Completed Early / Before Attention Needed Zone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_urgency_green" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Completed Early / On-Track"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Disciplined &amp; proactive ahead of schedule"
                        android:textColor="@color/color_text_tertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtCompletedOnTrackStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="0 (0%)"
                    android:textColor="@color/color_on_track_green"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- ============================================================= -->
        <!-- SECTION 5: RECENT SESSIONS ACTIVITY                           -->
        <!-- ============================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:text="RECENT FOCUS ACTIVITY"
                android:textColor="@color/color_text_tertiary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtNoAnalyticsSessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:paddingHorizontal="20dp"
            android:text="No focus sessions recorded in this period yet."
            android:textColor="@color/color_text_secondary"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAnalyticsRecentSessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
