<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:outlineProvider="background"
    android:clipToOutline="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Bottom Sheet Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_chip_pearl" />

        <!-- Header: Title & Close / Delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtSheetHeader"
                style="@style/TextAppearance.Tascyn.SectionHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Task Details" />

            <ImageView
                android:id="@+id/btnDeleteTaskInSheet"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_pearl"
                android:padding="6dp"
                android:src="@drawable/ic_trash_precision"
                android:visibility="gone"
                app:tint="@color/color_urgent_red"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/btnCloseSheet"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_pearl"
                android:padding="6dp"
                android:src="@drawable/ic_close_precision"
                app:tint="@color/color_carbon" />
        </LinearLayout>

        <!-- Task Title Input -->
        <EditText
            android:id="@+id/edtTaskTitle"
            style="@style/TextAppearance.Tascyn.LargeHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@null"
            android:hint="What needs to be done?"
            android:textColor="@color/color_void"
            android:textColorHint="@color/color_steel"
            android:textSize="18sp" />

        <!-- Formula Results Matrix Banner (if existing task) -->
        <LinearLayout
            android:id="@+id/layoutSheetMatrixBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip_pearl"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/txtSheetQuadrant"
                style="@style/TextAppearance.Tascyn.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_quadrant_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:textColor="@color/color_void"
                android:textStyle="bold"
                tools:text="Q16 · Do Now" />

            <TextView
                android:id="@+id/txtSheetTimeLeft"
                style="@style/TextAppearance.Tascyn.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_urgency_red"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:textColor="@color/color_urgent_red"
                tools:text="Urgent · 0d 2h 0m" />

            <TextView
                android:id="@+id/txtSheetDurationTracked"
                style="@style/TextAppearance.Tascyn.Metadata"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/color_steel"
                tools:text="Tracked: 2h 25m" />
        </LinearLayout>

        <!-- Priority Selector -->
        <TextView
            style="@style/TextAppearance.Tascyn.Micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="PRIORITY"
            android:textColor="@color/color_steel" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPriorityHigh"
                style="@style/TextAppearance.Tascyn.Micro"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:text="HIGH"
                android:textColor="@color/color_carbon" />

            <TextView
                android:id="@+id/btnPriorityMedium"
                style="@style/TextAppearance.Tascyn.Micro"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selected"
                android:gravity="center"
                android:text="MEDIUM"
                android:textColor="@color/color_white" />

            <TextView
                android:id="@+id/btnPriorityLow"
                style="@style/TextAppearance.Tascyn.Micro"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:text="LOW"
                android:textColor="@color/color_carbon" />
        </LinearLayout>

        <!-- Status Selector -->
        <TextView
            style="@style/TextAppearance.Tascyn.Micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="STATUS"
            android:textColor="@color/color_steel" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnStatusNotStarted"
                    style="@style/TextAppearance.Tascyn.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_chip_selected"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Not started"
                    android:textColor="@color/color_white" />

                <TextView
                    android:id="@+id/btnStatusInProgress"
                    style="@style/TextAppearance.Tascyn.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="In progress"
                    android:textColor="@color/color_carbon" />

                <TextView
                    android:id="@+id/btnStatusProcrastinated"
                    style="@style/TextAppearance.Tascyn.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Procrastinated"
                    android:textColor="@color/color_carbon" />

                <TextView
                    android:id="@+id/btnStatusLeft"
                    style="@style/TextAppearance.Tascyn.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Left"
                    android:textColor="@color/color_carbon" />

                <TextView
                    android:id="@+id/btnStatusDone"
                    style="@style/TextAppearance.Tascyn.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Done"
                    android:textColor="@color/color_carbon" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Due Date & Minimum Time Required Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <!-- Due Date Field -->
            <LinearLayout
                android:id="@+id/btnSelectDueDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_calendar_precision"
                    app:tint="@color/color_steel" />

                <TextView
                    android:id="@+id/txtSelectedDueDate"
                    style="@style/TextAppearance.Tascyn.Metadata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:hint="Set Due Date"
                    android:textColor="@color/color_void"
                    android:textColorHint="@color/color_steel" />
            </LinearLayout>

            <!-- Minimum Time Required Field -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_time_precision"
                    app:tint="@color/color_steel" />

                <EditText
                    android:id="@+id/edtMinTimeRequired"
                    style="@style/TextAppearance.Tascyn.Metadata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@null"
                    android:hint="Min time (e.g. 0d 2h 0m)"
                    android:text="0d 1h 0m"
                    android:textColor="@color/color_void"
                    android:textColorHint="@color/color_steel" />
            </LinearLayout>
        </LinearLayout>

        <!-- Task Types Multi-Select Chips Container -->
        <TextView
            style="@style/TextAppearance.Tascyn.Micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="TASK TYPES"
            android:textColor="@color/color_steel" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTaskTypes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:singleSelection="false">
            <!-- Populated dynamically -->
        </com.google.android.material.chip.ChipGroup>

        <!-- Comment / Notes Input -->
        <TextView
            style="@style/TextAppearance.Tascyn.Micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="COMMENT / NOTES"
            android:textColor="@color/color_steel" />

        <EditText
            android:id="@+id/edtTaskComment"
            style="@style/TextAppearance.Tascyn.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field"
            android:gravity="top|start"
            android:hint="Add context, formulas, notes..."
            android:minLines="2"
            android:padding="10dp"
            android:textColor="@color/color_void"
            android:textColorHint="@color/color_steel"
            android:textSize="13sp" />

        <!-- Sub-tasks Section (if top-level task) -->
        <LinearLayout
            android:id="@+id/layoutSubtasksSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Tascyn.Micro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SUB-TASKS"
                    android:textColor="@color/color_steel" />

                <TextView
                    android:id="@+id/btnAddSubtaskTrigger"
                    style="@style/TextAppearance.Tascyn.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_add_precision"
                    android:drawablePadding="2dp"
                    android:drawableTint="@color/color_void"
                    android:text="ADD SUB-TASK"
                    android:textColor="@color/color_void" />
            </LinearLayout>

            <!-- Subtask Add Inline Form -->
            <LinearLayout
                android:id="@+id/layoutInlineAddSubtask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/edtSubtaskTitleInput"
                    style="@style/TextAppearance.Tascyn.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="Subtask title"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/btnConfirmAddSubtask"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_button_primary"
                    android:padding="8dp"
                    android:src="@drawable/ic_add_precision"
                    app:tint="@color/color_white" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSubtasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <!-- Save and Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartSessionFromDetail"
                style="@style/Widget.Tascyn.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start Work" />

            <Button
                android:id="@+id/btnSaveTask"
                style="@style/Widget.Tascyn.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Save Task" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
